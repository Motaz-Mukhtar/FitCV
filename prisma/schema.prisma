generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String          @unique @db.VarChar(255)
  password_hash String          @db.VarChar(255)
  created_at    DateTime        @default(now()) @db.Timestamp(6)
  updated_at    DateTime        @default(now()) @db.Timestamp(6)
  deleted_at    DateTime?       @db.Timestamp(6)
  profiles      Profile[]
  submissions   JobSubmission[]
  documents     GeneratedDocument[]

  @@map("users")
}

model Profile {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String          @db.Uuid
  full_name     String?          @db.VarChar(150)
  title         String?         @db.VarChar(150)
  summary       String?         @db.Text
  email         String?          @db.VarChar(255)
  phone         String?         @db.VarChar(20)
  location      String?         @db.VarChar(150)
  linkedin_url  String?         @db.VarChar(255)
  portfolio_url String?         @db.VarChar(255)
  is_default    Boolean         @default(false)
  created_at    DateTime        @default(now()) @db.Timestamp(6)
  updated_at    DateTime        @default(now()) @db.Timestamp(6)
  deleted_at    DateTime?       @db.Timestamp(6)
  user          User            @relation(fields: [user_id], references: [id])
  experiences   Experience[]
  skills        Skill[]
  education     Education[]
  submissions   JobSubmission[]

  @@map("profiles")
}

model Education {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile_id  String    @db.Uuid
  institution String    @db.VarChar(150)
  degree      String    @db.VarChar(150)
  field       String    @db.VarChar(150)
  start_date  DateTime  @db.Date
  end_date    DateTime? @db.Date
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  deleted_at  DateTime? @db.Timestamp(6)
  profile     Profile   @relation(fields: [profile_id], references: [id])

  @@map("education")
}

model Experience {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile_id  String    @db.Uuid
  company     String    @db.VarChar(150)
  role        String    @db.VarChar(150)
  start_date  DateTime  @db.Date
  end_date    DateTime? @db.Date
  description String?   @db.Text
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  updated_at  DateTime  @default(now()) @db.Timestamp(6)
  deleted_at  DateTime? @db.Timestamp(6)
  profile     Profile   @relation(fields: [profile_id], references: [id])

  @@map("experiences")
}

enum SkillType {
  hard
  soft
}

model Skill {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile_id String    @db.Uuid
  name       String    @db.VarChar(100)
  type       SkillType
  created_at DateTime  @default(now()) @db.Timestamp(6)
  profile    Profile   @relation(fields: [profile_id], references: [id])

  @@map("skills")
}

model JobSubmission {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String              @db.Uuid
  profile_id   String              @db.Uuid
  company_name String?             @db.VarChar(150)
  job_title    String?             @db.VarChar(150)
  description  String              @db.Text
  created_at   DateTime            @default(now()) @db.Timestamp(6)
  user         User                @relation(fields: [user_id], references: [id])
  profile      Profile             @relation(fields: [profile_id], references: [id])
  documents    GeneratedDocument[]

  @@map("job_submissions")
}

enum DocumentType {
  cv
  cover_letter
  summary
}

model GeneratedDocument {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job_submission_id String        @db.Uuid
  user_id           String        @db.Uuid
  type              DocumentType
  content           Json          @db.JsonB
  created_at        DateTime      @default(now()) @db.Timestamp(6)
  submission        JobSubmission @relation(fields: [job_submission_id], references: [id])
  user              User          @relation(fields: [user_id], references: [id])

  @@map("generated_documents")
}
